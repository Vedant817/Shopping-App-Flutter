GeneratedPluginRegistrant.java

# Remember to never publicly share your keystore.
# See https://flutter.dev/docs/deployment/android#reference-the-keystore-from-the-app
key.properties
**/*.keystore
**/*.jks
# PKCS12 is the format keytool recommends and the one Gradle handles most
# reliably, and its conventional extension is .p12. Without this line a release
# keystore using that extension is not ignored and lands in the repository on the
# next `git add -A`, which is the one mistake that cannot be undone: Play Store
# will not accept a replacement signing key for an existing app.
**/*.p12
