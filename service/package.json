{
  "name": "threadline-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node dist/migrate.js",
    "migrations:sync": "node scripts/sync-migrations.mjs",
    "migrations:check": "node scripts/sync-migrations.mjs --check",
    "test:migrations:clean": "npm run build && node scripts/clean-migrate-check.mjs",
    "test:rls-roles": "node scripts/rls-role-check.mjs",
    "test:docker": "npm run build && node scripts/docker-check.mjs",
    "test:smoke": "node scripts/local-smoke.mjs",
    "verify:live": "node scripts/live-verification.mjs",
    "inspect:live": "node scripts/inspect-synced-data.mjs",
    "inspect:live-jobs": "node scripts/inspect-failed-jobs.mjs",
    "serve:web": "node ../tool/serve-web.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/sensible": "^6.0.3",
    "decimal.js": "^10.5.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.0.1",
    "fastify-raw-body": "^5.0.0",
    "jose": "^6.0.11",
    "pg": "^8.16.3",
    "sanitize-html": "^2.17.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
